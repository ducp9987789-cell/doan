# ============================================================================== #
#                      FASHION STORE AI - FRONTEND ENV                           #
# ============================================================================== #

# ========================================== #
# 1. FRONTEND SERVER CONFIGURATION           #
# ========================================== #
# Port phát triển cục bộ của Vite dev server
PORT=5173

# ========================================== #
# 2. BACKEND API PROXY & BASE URL            #
# ========================================== #
# URL gốc của Backend API khi gọi qua axios
VITE_API_BASE_URL=/api/v1

# Địa chỉ backend server để Vite dev server forward /api request trong môi trường local
VITE_API_PROXY=http://localhost:8000
