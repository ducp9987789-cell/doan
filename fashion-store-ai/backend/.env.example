# ============================================================================== #
#                       FASHION STORE AI - BACKEND ENV                           #
# ============================================================================== #

# ========================================== #
# 1. BACKEND & APP CONFIGURATION (FastAPI)   #
# ========================================== #
APP_NAME="Fashion Store AI"
APP_ENV=development
SECRET_KEY=your-super-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ========================================== #
# 2. DATABASE CONFIGURATION (MongoDB)        #
# ========================================== #
# Local development: mongodb://localhost:27017
# Docker environment: mongodb://mongo:27017
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=fashion_store

# ========================================== #
# 3. REDIS (chat session + RAG cache)        #
# ========================================== #
# Local: redis://localhost:6379/0
# Docker: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_TTL_SECONDS=86400
REDIS_RAG_CACHE_TTL_SECONDS=300

# ========================================== #
# 4. AI, LLM & VECTOR DATABASE (RAG/Qdrant)  #
# ========================================== #
# Local: http://localhost:6333
# Docker: http://qdrant:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=fashion_knowledge

# LLM Provider selection: "openai" or "gemini" (fallback to local rule-based if empty)
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ========================================== #
# 5. ADMIN SEED & DEFAULT CREDENTIALS        #
# ========================================== #
SEED_ON_STARTUP=true
ADMIN_EMAIL=Admin@fashion.vn
ADMIN_PASSWORD=Admin@123

# ========================================== #
# 6. FRONTEND & CORS CLIENT CONFIGURATION    #
# ========================================== #
# Allowed frontend URLs (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ========================================== #
# 7. EMAIL & SMTP CONFIGURATION              #
# ========================================== #
# Cấu hình gửi mail OTP qua SMTP (ví dụ Gmail App Password, SendGrid,...)
# Nếu để trống, hệ thống sẽ tự động dùng chế độ Demo Mock (ghi log và hiển thị OTP ở giao diện)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Fashion Store AI"
SMTP_TLS=true
