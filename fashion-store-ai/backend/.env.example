# ============================================================================== #
#                       FASHION STORE AI - BACKEND ENV                           #
# ============================================================================== #

# ========================================== #
# 1. BACKEND & APP CONFIGURATION (FastAPI)   #
# ========================================== #
APP_NAME="Fashion Store AI"
APP_ENV=development
SECRET_KEY=your-super-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ========================================== #
# 2. DATABASE CONFIGURATION (MongoDB)        #
# ========================================== #
# Local development: mongodb://localhost:27017
# Docker environment: mongodb://mongo:27017
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=fashion_store

# ========================================== #
# 3. AI, LLM & VECTOR DATABASE (RAG)         #
# ========================================== #
# Vector Database persistence directory
CHROMA_PERSIST_DIR=./data/chroma

# LLM Provider selection: "openai" or "gemini" (fallback to local rule-based if empty)
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ========================================== #
# 4. ADMIN SEED & DEFAULT CREDENTIALS        #
# ========================================== #
SEED_ON_STARTUP=true
ADMIN_EMAIL=Admin@fashion.vn
ADMIN_PASSWORD=Admin@123

# ========================================== #
# 5. FRONTEND & CORS CLIENT CONFIGURATION    #
# ========================================== #
# Allowed frontend URLs (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
